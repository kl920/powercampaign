generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  PARTICIPANT
  TENANT_ADMIN
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum MeterProviderType {
  DEMO
  ENERGINET
  UTILITY_PARTNER
}

enum MeterConnectionStatus {
  PENDING
  CONNECTED
  REVOKED
  FAILED
}

enum HousingType {
  APARTMENT
  HOUSE
  TOWNHOUSE
  OTHER
}

enum BaselineMethod {
  LAST_4_WEEKS
  LAST_2_WEEKS
  SAME_WEEK_LAST_YEAR
  MODELED
}

enum LeaderboardType {
  GLOBAL
  GROUP
  LOCAL
}

enum GroupType {
  PRIVATE
  PUBLIC
  COMPANY
  STREET
  CITY
}

enum MissionType {
  SELF_REPORTED
  DATA_DRIVEN
  EDUCATIONAL
}

enum RewardCriteriaType {
  TOP_RANK
  RANDOM_DRAW
  MISSION_BASED
  REFERRAL_BASED
}

enum ConsentType {
  PARTICIPATION
  MARKETING
  DATA_ACCESS
}

enum ExportType {
  PARTICIPANTS
  RESULTS
  CONSENTS
  GROUP_STANDINGS
}

enum ExportStatus {
  COMPLETED
  FAILED
}

enum NotificationType {
  WELCOME
  CONNECT_DATA_REMINDER
  CHALLENGE_STARTS
  DAILY_PROGRESS
  INVITE
  ENDING_SOON
  WINNER_ANNOUNCEMENT
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum Granularity {
  HOUR
  DAY
}

enum DataSource {
  DEMO
  ENERGINET
  UTILITY_PARTNER
}

// ─── TENANT ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branding         TenantBranding?
  memberships      TenantMembership[]
  campaigns        Campaign[]
  households       Household[]
  groups           Group[]
  consentRecords   ConsentRecord[]
  auditLogs        AuditLog[]
  exportJobs       ExportJob[]
  notificationLogs NotificationLog[]
}

model TenantBranding {
  id             String  @id @default(cuid())
  tenantId       String  @unique
  logoUrl        String?
  primaryColor   String  @default("#0F766E")
  secondaryColor String  @default("#F59E0B")
  headline       String?
  subheadline    String?
  supportEmail   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantMembership {
  id       String   @id @default(cuid())
  userId   String
  tenantId String
  role     UserRole @default(PARTICIPANT)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// ─── CAMPAIGN ─────────────────────────────────────────────────────────────────

model Campaign {
  id                      String         @id @default(cuid())
  tenantId                String
  name                    String
  slug                    String         @unique
  description             String?
  status                  CampaignStatus @default(DRAFT)
  startsAt                DateTime
  endsAt                  DateTime
  baselineMethodDefault   BaselineMethod @default(LAST_4_WEEKS)
  co2FactorKgPerKwh       Decimal        @db.Decimal(10, 6)
  estimatedPricePerKwhDkk Decimal        @db.Decimal(10, 4)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baselineSnapshots  BaselineSnapshot[]
  challengeResults   ChallengeResult[]
  leaderboardEntries LeaderboardEntry[]
  groups             Group[]
  missions           Mission[]
  rewards            Reward[]
  referrals          Referral[]
  exportJobs         ExportJob[]

  @@index([tenantId])
  @@index([status])
}

// ─── USER ─────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships       TenantMembership[]
  ownedHouseholds   Household[]        @relation("HouseholdOwner")
  householdMembers  HouseholdMember[]
  referralsSent     Referral[]
  consentRecords    ConsentRecord[]
  auditLogs         AuditLog[]
  exportJobsCreated ExportJob[]        @relation("ExportCreator")
  notificationLogs  NotificationLog[]
}

// ─── HOUSEHOLD ────────────────────────────────────────────────────────────────

model Household {
  id            String      @id @default(cuid())
  tenantId      String
  ownerUserId   String
  postalCode    String
  housingType   HousingType
  householdSize Int
  floorAreaM2   Int?
  movedInAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUser User   @relation("HouseholdOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  members              HouseholdMember[]
  meterConnections     MeterConnection[]
  consumptionIntervals ConsumptionInterval[]
  baselineSnapshots    BaselineSnapshot[]
  challengeResults     ChallengeResult[]
  leaderboardEntries   LeaderboardEntry[]
  groupMemberships     GroupMembership[]
  missionCompletions   MissionCompletion[]
  userBadges           UserBadge[]

  @@index([tenantId])
  @@index([ownerUserId])
}

model HouseholdMember {
  id          String  @id @default(cuid())
  householdId String
  userId      String
  roleLabel   String?

  createdAt DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

// ─── METER DATA ───────────────────────────────────────────────────────────────

model MeterConnection {
  id                 String                @id @default(cuid())
  householdId        String
  providerType       MeterProviderType
  status             MeterConnectionStatus @default(PENDING)
  providerExternalId String?
  consentGrantedAt   DateTime?
  consentRevokedAt   DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meterPoints MeterPoint[]

  @@index([householdId])
}

model MeterPoint {
  id                String  @id @default(cuid())
  meterConnectionId String
  externalMeterId   String
  priceArea         String?

  createdAt DateTime @default(now())

  meterConnection      MeterConnection     @relation(fields: [meterConnectionId], references: [id], onDelete: Cascade)
  consumptionIntervals ConsumptionInterval[]

  @@index([meterConnectionId])
  @@index([externalMeterId])
}

model ConsumptionInterval {
  id           String      @id @default(cuid())
  householdId  String
  meterPointId String
  timestamp    DateTime
  granularity  Granularity @default(HOUR)
  kwh          Decimal     @db.Decimal(12, 4)
  source       DataSource
  importedAt   DateTime    @default(now())

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meterPoint MeterPoint @relation(fields: [meterPointId], references: [id], onDelete: Cascade)

  @@unique([meterPointId, timestamp, granularity])
  @@index([householdId, timestamp])
  @@index([meterPointId, timestamp])
}

// ─── BASELINE & SCORING ──────────────────────────────────────────────────────

model BaselineSnapshot {
  id                    String         @id @default(cuid())
  campaignId            String
  householdId           String
  method                BaselineMethod
  baselineKwh           Decimal        @db.Decimal(12, 4)
  baselinePeakKwh       Decimal?       @db.Decimal(12, 4)
  comparisonWeeksCount  Int
  limitedBaseline       Boolean        @default(false)
  dataCompletenessScore Decimal?       @db.Decimal(5, 2)
  sameWeekLastYearKwh   Decimal?       @db.Decimal(12, 4)
  calculatedAt          DateTime       @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([campaignId, householdId])
  @@index([campaignId])
}

model ChallengeResult {
  id                         String   @id @default(cuid())
  campaignId                 String
  householdId                String
  challengeKwh               Decimal  @db.Decimal(12, 4)
  savingKwh                  Decimal  @db.Decimal(12, 4)
  savingPercent              Decimal  @db.Decimal(8, 4)
  estimatedDkkSaved          Decimal  @db.Decimal(12, 4)
  estimatedCo2Saved          Decimal  @db.Decimal(12, 6)
  peakHourReductionPercent   Decimal? @db.Decimal(8, 4)
  consistencyScore           Decimal? @db.Decimal(5, 2)
  challengeDataCompleteness  Decimal? @db.Decimal(5, 2)
  eligibleForMainLeaderboard Boolean  @default(true)
  anomalyFlag                Boolean  @default(false)
  anomalyReason              String?
  calculatedAt               DateTime @default(now())

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([campaignId, householdId])
  @@index([campaignId, eligibleForMainLeaderboard])
}

// ─── LEADERBOARD ──────────────────────────────────────────────────────────────

model LeaderboardEntry {
  id              String          @id @default(cuid())
  campaignId      String
  householdId     String
  leaderboardType LeaderboardType
  groupId         String?
  rank            Int
  score           Decimal         @db.Decimal(12, 4)
  updatedAt       DateTime        @updatedAt

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([campaignId, leaderboardType, rank])
  @@index([householdId])
}

// ─── GROUPS (Fase 2 UI) ──────────────────────────────────────────────────────

model Group {
  id         String    @id @default(cuid())
  campaignId String
  tenantId   String
  name       String
  type       GroupType
  inviteCode String    @unique
  createdAt  DateTime  @default(now())

  campaign           Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships        GroupMembership[]
  leaderboardEntries LeaderboardEntry[]

  @@index([campaignId])
  @@index([tenantId])
}

model GroupMembership {
  id          String @id @default(cuid())
  groupId     String
  householdId String

  createdAt DateTime @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([groupId, householdId])
}

// ─── MISSIONS (Fase 2 UI) ────────────────────────────────────────────────────

model Mission {
  id          String      @id @default(cuid())
  campaignId  String
  title       String
  description String
  type        MissionType
  points      Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  campaign    Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  completions MissionCompletion[]

  @@index([campaignId])
}

model MissionCompletion {
  id          String   @id @default(cuid())
  missionId   String
  householdId String
  completedAt DateTime @default(now())

  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([missionId, householdId])
}

// ─── BADGES (Fase 2 UI) ──────────────────────────────────────────────────────

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  iconKey     String?
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  badgeId     String
  householdId String
  awardedAt   DateTime @default(now())

  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([badgeId, householdId])
}

// ─── REWARDS (Fase 2 UI) ─────────────────────────────────────────────────────

model Reward {
  id           String             @id @default(cuid())
  campaignId   String
  title        String
  description  String?
  criteriaType RewardCriteriaType
  quantity     Int
  createdAt    DateTime           @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ─── REFERRALS (Fase 2 UI) ───────────────────────────────────────────────────

model Referral {
  id            String    @id @default(cuid())
  campaignId    String
  inviterUserId String
  invitedEmail  String?
  inviteCode    String    @unique
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inviterUser User     @relation(fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([inviterUserId])
}

// ─── CONSENT & COMPLIANCE ─────────────────────────────────────────────────────

model ConsentRecord {
  id           String      @id @default(cuid())
  userId       String
  tenantId     String
  consentType  ConsentType
  version      String
  accepted     Boolean
  acceptedAt   DateTime
  metadataJson Json?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, acceptedAt])
  @@index([tenantId])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  tenantId     String
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actorUser User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
}

// ─── EXPORTS ──────────────────────────────────────────────────────────────────

model ExportJob {
  id              String       @id @default(cuid())
  tenantId        String
  campaignId      String?
  type            ExportType
  status          ExportStatus @default(COMPLETED)
  fileUrl         String?
  rowCount        Int?
  createdByUserId String
  createdAt       DateTime     @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ExportCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([campaignId])
}

// ─── NOTIFICATIONS (Fase 2) ──────────────────────────────────────────────────

model NotificationLog {
  id           String              @id @default(cuid())
  tenantId     String
  userId       String?
  type         NotificationType
  channel      NotificationChannel
  sentAt       DateTime?
  status       String
  metadataJson Json?
  createdAt    DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
}
