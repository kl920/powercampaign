# PostgreSQL connection string (from Supabase, Railway, Neon, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true&connection_limit=1"

# Direct connection (used by Prisma migrations — same host, no pgbouncer)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Random 32+ char secret for session cookies
# Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-real-32-char-secret"
